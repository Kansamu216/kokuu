# KokuuHub systemd 服务单元（Linux）
#
# 安装步骤：
#   sudo useradd --system --no-create-home --shell /usr/sbin/nologin kokuu
#   sudo mkdir -p /opt/kokuuhub /var/lib/kokuuhub
#   sudo cp dist/kokuuhub-linux-amd64 /opt/kokuuhub/
#   sudo chmod +x /opt/kokuuhub/kokuuhub-linux-amd64
#   sudo chown -R kokuu:kokuu /var/lib/kokuuhub
#   sudo cp deploy/kokuuhub.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now kokuuhub
#   journalctl -u kokuuhub -f          # 看日志（里面会打印面板账号密码）
#
# 面板地址：http://<服务器IP>:9000

[Unit]
Description=KokuuHub - Minecraft 多服务器管理平台
Documentation=https://github.com/KokuuStudio
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kokuu
Group=kokuu
WorkingDirectory=/opt/kokuuhub

# 0.0.0.0 才能从外部访问；只在本机反代的话改成 127.0.0.1:9000 更安全
ExecStart=/opt/kokuuhub/kokuuhub-linux-amd64 -listen 0.0.0.0:9000 -data /var/lib/kokuuhub

# 崩了自动拉起
Restart=always
RestartSec=3

# 优雅停止：Go 侧监听了 SIGTERM，会把状态落盘再退
KillSignal=SIGTERM
TimeoutStopSec=15

# ---- 资源限制：Hub 很轻，卡个上限防止意外 ----
MemoryMax=256M
CPUQuota=50%

# ---- 安全加固 ----
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
# ProtectSystem=strict 下整个文件系统只读，只有下面这个目录可写
ReadWritePaths=/var/lib/kokuuhub

# 日志走 journald（也同时写 /var/lib/kokuuhub/hub.log）
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
